{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-network-modbus",
  "name": "Modbus",
  "version": "0.1.0",
  "description": "Monitor profile-described Modbus devices across TCP, TLS, RTU, and ASCII transports.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "protocol-bridge",
    "domain": "bridge",
    "preset_summary": "Protocol bridge starter for translating an external local protocol."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "docker.io/piphinetwork/piphi-network-modbus:0.1.0",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "docker.io/piphinetwork/piphi-network-modbus:0.1.0",
        "ports": [
          {
            "container": 4222,
            "host": 4222
          }
        ],
        "environment": {
          "LOG_LEVEL": "info"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "passive"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "host",
      "alias",
      "bridge_address",
      "protocol"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "host"
    ]
  },
  "identity": {
    "fields": [
      "host"
    ]
  },
  "capabilities": {
    "connected": {
      "kind": "sensor",
      "unit": "bool"
    },
    "refresh": {
      "kind": "action"
    }
  },
  "commands": {
    "refresh": {
      "description": "Refresh the device state.",
      "timeout_ms": 5000
    }
  },
  "entities": [
    {
      "id": "demo-device",
      "name": "Demo Device",
      "device_id": "demo-device",
      "entity_type": "modbus_device",
      "capabilities": [
        "connected",
        "refresh"
      ],
      "available_commands": [
        {
          "id": "refresh",
          "label": "Refresh",
          "kind": "action"
        }
      ],
      "dashboard": {
        "allowed_widgets": [
          "tile",
          "stat",
          "button"
        ],
        "default_widget": "tile"
      }
    }
  ],
  "marketplace": {
    "metadata_version": 2,
    "display_name": "Modbus",
    "summary": "Monitor profile-described Modbus devices across TCP, TLS, RTU, and ASCII transports.",
    "category": "other",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-network-modbus/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "local_network",
        "label": "Local network access",
        "reason": "Discovers or communicates with supported services and devices on the homeowner's local network.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Multi-vendor",
        "model": "Devices described by supported PiPhi Modbus profiles"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-network-modbus",
    "support_url": "https://github.com/PiPhi-io/piphi-network-modbus/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-network-modbus/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "industrial controller",
      "energy meter",
      "sensor",
      "actuator"
    ],
    "protocols": [
      "Modbus TCP",
      "Modbus TLS",
      "Modbus RTU",
      "Modbus ASCII"
    ],
    "discovery_methods": [
      "profile configuration",
      "manual"
    ],
    "connectivity": "local",
    "offline_support": "full"
  }
}
