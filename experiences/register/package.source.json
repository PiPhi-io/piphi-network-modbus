{
  "schema_version": "1",
  "identity": {"publisher_id": "io.piphi", "package_id": "modbus-register", "version": "0.1.1"},
  "name": "Modbus Register",
  "description": "One configured unsigned Modbus TCP holding register, read-only.",
  "origin": "integration",
  "owning_integration_id": "piphi-network-modbus",
  "sdk_version_range": ">=0.6.1,<0.7",
  "requires_integrations": [{"integration_id": "piphi-network-modbus", "version_range": ">=0.1,<1", "optional": false}],
  "recommended_for_integrations": ["piphi-network-modbus"],
  "widgets": [{
    "id": "holding-register",
    "name": "Holding Register",
    "description": "Unsigned raw value at the register address configured for this integration.",
    "runtime": "declarative",
    "presentation": {
      "contract_version": "1", "shell": "core", "content_surface": "transparent", "typography": "core",
      "appearance_controls": ["icon", "title", "surface", "opacity", "radius", "shadow"]
    },
    "interaction_targets": [
      {"id": "card", "label": "Modbus register", "kind": "card", "allowed_actions": ["more-info", "popout", "refresh"], "default_action": "more-info"},
      {"id": "value", "label": "Holding register value", "kind": "binding", "binding_slot_id": "value", "allowed_actions": ["more-info", "history", "popout"], "default_action": "more-info"}
    ],
    "binding_slots": [{
      "id": "value", "label": "Holding register value", "required": true, "binding_modes": ["read"],
      "capability_requirements": ["holding_register_value"], "compatible_integration_ids": ["piphi-network-modbus"],
      "data_delivery": {"mode": "stream_preferred", "stale_after_seconds": 600}
    }],
    "recipe": {
      "schema_version": "1", "layout": "grid", "columns": 1,
      "items": [{"type": "metric", "slot_id": "value", "label": "Register value", "format": "number", "emphasis": "hero", "action": {"type": "details", "label": "View register value"}}]
    },
    "certification": {
